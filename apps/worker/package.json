{
  "name": "@gani/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "tenant:create-org": "node scripts/tenant.mjs create-org",
    "tenant:create-workspace": "node scripts/tenant.mjs create-workspace",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@gani/bot-runtime": "workspace:*",
    "@gani/channels": "workspace:*",
    "@gani/conversations": "workspace:*",
    "@gani/db": "workspace:*",
    "@gani/domain": "workspace:*",
    "@gani/email": "workspace:*",
    "@socket.io/redis-emitter": "5.1.0",
    "bullmq": "5.81.5",
    "ioredis": "5.11.1"
  },
  "devDependencies": {
    "@gani/config": "workspace:*",
    "@node-rs/argon2": "2.2.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.3",
    "smtp-server": "3.19.17",
    "@types/smtp-server": "3.5.13",
    "socket.io-client": "4.8.3",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
