{
  "name": "@gani/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "smoke": "node scripts/smoke-start.mjs",
    "bootstrap:operator": "node scripts/bootstrap-platform-operator.mjs",
    "openapi": "node scripts/openapi.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@gani/channels": "workspace:*",
    "@gani/conversations": "workspace:*",
    "@gani/db": "workspace:*",
    "@gani/domain": "workspace:*",
    "@gani/email": "workspace:*",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@node-rs/argon2": "2.2.1",
    "@socket.io/redis-adapter": "8.3.0",
    "better-auth": "1.7.7",
    "ioredis": "5.11.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@gani/config": "workspace:*",
    "@nestjs/testing": "12.1.2",
    "@swc/core": "1.16.13",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.3",
    "socket.io-client": "4.8.3",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.3"
  }
}
