{
  "name": "gani-platform-chat",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "^22.13.0 || ^24.0.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "prepare": "node scripts/setup-hooks.mjs",
    "dev": "pnpm dev:infra && pnpm dev:api",
    "dev:infra": "docker compose --env-file .env -f infra/docker/docker-compose.yml up -d",
    "dev:api": "pnpm --filter @gani/db build && pnpm --filter @gani/api dev",
    "dev:worker": "pnpm --filter @gani/db build && pnpm --filter @gani/worker dev",
    "build": "turbo run build",
    "build:e2e-check": "pnpm --filter @gani/admin build:e2e-check",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"{apps,packages}/**/*.{ts,mjs,json}\" \"*.{json,mjs}\"",
    "format:check": "prettier --check \"{apps,packages}/**/*.{ts,mjs,json}\" \"*.{json,mjs}\""
  },
  "devDependencies": {
    "@gani/config": "workspace:*",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "turbo": "2.11.7",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  },
  "pnpm": {
    "overrides": {
      "body-parser@>=2.0.0 <2.4.0": "2.4.0",
      "multer@>=2.0.0 <2.5.0": "2.5.0"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
