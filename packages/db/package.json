{
  "name": "@gani/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "migrate": "node scripts/migrate.mjs",
    "backfill:last-message-preview": "node scripts/backfill-last-message-preview.mjs",
    "lint:migrations": "node lint/lint-migrations.mjs",
    "test": "node --test --experimental-test-coverage --test-coverage-lines=80 \"lint/*.test.mjs\" && vitest run --coverage",
    "pretest:integration": "bash ../../scripts/check-db.sh",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@gani/config": "workspace:*",
    "@gani/domain": "workspace:*",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.3",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
