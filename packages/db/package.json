{
  "name": "@gani/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "migrate": "node scripts/migrate.mjs",
    "lint:migrations": "node lint/lint-migrations.mjs",
    "test": "node --test --experimental-test-coverage --test-coverage-lines=80 \"lint/*.test.mjs\" && vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@gani/config": "workspace:*",
    "@gani/domain": "workspace:*",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.3",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
