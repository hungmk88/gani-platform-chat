EVENTS_CONSUMER_ENABLED=
EVENTS_DISCOVERY_MS=
EVENTS_MAX_QUEUES=
EVENTS_CONCURRENCY=
# Renewal of the channel tokens (B2): 0 by default; the worker refuses 1 until the Zalo token client exists (B2-3).
# CHANNEL_REFRESH_LEASE_S x 1000 must be at least 2 x CHANNEL_REFRESH_TIMEOUT_MS.
CHANNEL_REFRESH_ENABLED=
CHANNEL_REFRESH_POLL_MS=
CHANNEL_REFRESH_BEFORE_S=
CHANNEL_REFRESH_LEASE_S=
CHANNEL_REFRESH_TIMEOUT_MS=
CHANNEL_REFRESH_WARN_S=
CHANNEL_REFRESH_ORGS_PER_TICK=
CHANNEL_REFRESH_ORG_PARALLEL=
# Outbound worker (O2, N185): sends the pending deliveries to their channel. Off (0) until a channel sender exists (O3, Q6):
# readConfig refuses OUTBOUND_ENABLED=1 before that. 5 attempts with the relay's backoff, then failed (A 02/11/2026).
# OUTBOUND_LEASE_S x 1000 must be at least 2 x OUTBOUND_TIMEOUT_MS.
OUTBOUND_ENABLED=
OUTBOUND_POLL_MS=
OUTBOUND_LEASE_S=
OUTBOUND_TIMEOUT_MS=
OUTBOUND_MAX_ATTEMPTS=
OUTBOUND_ORGS_PER_TICK=
OUTBOUND_ORG_PARALLEL=
# Release of the conversations held outside business hours (C10-4b, T08, N193): on (1) by default, every 60 s (CEO 03/11/2026).
AFTER_HOURS_ENABLED=
AFTER_HOURS_POLL_MS=
AFTER_HOURS_ORGS_PER_TICK=
AFTER_HOURS_ORG_PARALLEL=
AFTER_HOURS_BATCH=
WORKER_HTTP_PORT=
WORKER_HEALTH_MAX_AGE_S=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
SOCKET_REVALIDATE_S=

# Keys of SecretBox for the secrets of the channel accounts (zalo spec §2): 64 hex characters (32 bytes) each, one per version.
# A new secret is written with the highest version; never commit a value.
CHANNEL_SECRET_KEY_1=
AUTH_ALLOW_HTTP=
SENTRY_DSN=
PORT=
HOST=
POSTGRES_PASSWORD=
APP_ROLE_PASSWORD=
AUTH_ROLE_PASSWORD=
MIGRATION_ROLE_PASSWORD=
SUPPORT_TEST_LOGIN_PASSWORD=
BOOTSTRAP_OPERATOR_EMAIL=
BOOTSTRAP_OPERATOR_PASSWORD=
BOOTSTRAP_OPERATOR_NAME=
