# Chỉ chứa TÊN biến, không có giá trị. Không bao giờ commit file .env thật.
# Thêm biến mới ở đây cùng PR với code đọc biến đó.

APP_ENV=
DATABASE_URL_APP=
DATABASE_URL_AUTH=
DATABASE_URL_MIGRATION=
