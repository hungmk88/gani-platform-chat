{
  "openapi": "3.1.0",
  "info": {
    "title": "Gani Platform API — planned",
    "version": "0.1.0-planned",
    "description": "Paths NOT served yet (`x-status: planned`, `x-sprint`): the contract the front end builds on until each moves to openapi.json. Same rules as openapi.json: session cookie, organisation from the session, RFC 9457 errors with a snake_case `code`."
  },
