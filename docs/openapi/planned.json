{
  "openapi": "3.1.0",
  "info": {
    "title": "Gani Platform API — planned",
    "version": "0.1.0-planned",
    "description": "Paths NOT served yet (`x-status: planned`, `x-sprint`): the contract the front end builds on until each moves to openapi.json. Same rules as openapi.json: session cookie, organisation from the session, RFC 9457 errors with a snake_case `code`."
  },
  "components": {
    "schemas": {
      "TicketPage": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Ticket"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "data",
          "nextCursor"
        ]
      },
      "Ticket": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Uuid"
          },
          "workspaceId": {
            "$ref": "#/components/schemas/Uuid"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "new",
              "in_progress",
              "waiting_customer",
              "done",
              "cancelled"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "normal",
              "high",
              "urgent"
            ]
          },
          "type": {
            "type": [
              "string",
              "null"
            ]
          },
          "customer": {
            "$ref": "#/components/schemas/TicketCustomer"
          },
          "conversationId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "UUIDv7, or null."
          },
          "assignee": {
            "$ref": "#/components/schemas/TicketAssignee"
          },
          "sla": {
            "$ref": "#/components/schemas/TicketSla"
          },
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "createdBy": {
            "$ref": "#/components/schemas/Uuid"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "workspaceId",
          "title",
          "description",
          "status",
          "priority",
          "type",
          "customer",
          "conversationId",
          "assignee",
          "sla",
          "version",
          "createdBy",
          "createdAt",
          "updatedAt"
        ]
      },
      "Uuid": {
        "type": "string",
        "format": "uuid",
        "description": "UUIDv7."
      },
      "TicketCustomer": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Uuid"
          },
          "displayName": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "displayName"
        ]
      },
      "TicketAssignee": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Uuid"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "TicketSla": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "dueAt": {
            "type": "string",
            "format": "date-time"
          },
          "pausedReason": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "waiting_customer",
              "outside_hours",
              null
            ]
          }
        },
        "required": [
          "dueAt",
          "pausedReason"
        ]
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "about:blank"
            ]
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "detail": {
            "type": "string"
          },
          "traceId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "description": "RFC 9457 problem details; `code` is the stable word (Brief P9)."
      },
      "TicketCreate": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "$ref": "#/components/schemas/Uuid"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "maxLength": 5000
          },
          "priority": {
            "type": "string",
            "enum": [
              "normal",
              "high",
              "urgent"
            ],
            "default": "normal"
          },
          "customerId": {
            "$ref": "#/components/schemas/Uuid"
          },
          "conversationId": {
            "$ref": "#/components/schemas/Uuid"
          },
          "assigneeUserId": {
            "$ref": "#/components/schemas/Uuid"
          }
        },
        "required": [
          "workspaceId",
          "title"
        ],
        "additionalProperties": false
      },
      "TicketDetail": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Uuid"
          },
          "workspaceId": {
            "$ref": "#/components/schemas/Uuid"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "new",
              "in_progress",
              "waiting_customer",
              "done",
              "cancelled"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "normal",
              "high",
              "urgent"
            ]
          },
          "type": {
            "type": [
              "string",
              "null"
            ]
          },
          "customer": {
            "$ref": "#/components/schemas/TicketCustomer"
          },
          "conversationId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "UUIDv7, or null."
          },
          "assignee": {
            "$ref": "#/components/schemas/TicketAssignee"
          },
          "sla": {
            "$ref": "#/components/schemas/TicketSla"
          },
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "createdBy": {
            "$ref": "#/components/schemas/Uuid"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TicketEvent"
            }
          }
        },
        "required": [
          "id",
          "workspaceId",
          "title",
          "description",
          "status",
          "priority",
          "type",
          "customer",
          "conversationId",
          "assignee",
          "sla",
          "version",
          "createdBy",
          "createdAt",
          "updatedAt",
          "events"
        ]
      },
      "TicketEvent": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "created",
              "status_changed",
              "assigned",
              "edited"
            ]
          },
          "fromStatus": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "new",
              "in_progress",
              "waiting_customer",
              "done",
              "cancelled",
              null
            ]
          },
          "toStatus": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "new",
              "in_progress",
              "waiting_customer",
              "done",
              "cancelled",
              null
            ]
          },
          "actorUserId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "UUIDv7, or null."
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "type",
          "fromStatus",
          "toStatus",
          "actorUserId",
          "occurredAt"
        ]
      },
      "TicketChange": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "type": "string",
            "enum": [
              "new",
              "in_progress",
              "waiting_customer",
              "done",
              "cancelled"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 5000
          },
          "priority": {
            "type": "string",
            "enum": [
              "normal",
              "high",
              "urgent"
            ]
          },
          "assigneeUserId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "UUIDv7, or null."
          }
        },
        "required": [
          "version"
        ],
        "additionalProperties": false
      }
    },
    "parameters": {}
  },
  "paths": {
    "/v1/tickets": {
      "get": {
        "x-status": "planned",
        "x-sprint": "S4",
        "summary": "Tickets of the session’s workspaces, newest first; filter by workspace, status and assignee. Sales see the ones they made.",
        "tags": [
          "tickets"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "required": false,
            "name": "cursor",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            },
            "required": false,
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "$ref": "#/components/schemas/Uuid"
            },
            "required": false,
            "description": "UUIDv7.",
            "name": "workspaceId",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "new",
                "in_progress",
                "waiting_customer",
                "done",
                "cancelled"
              ]
            },
            "required": false,
            "name": "status",
            "in": "query"
          },
          {
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "me",
                    "none"
                  ]
                },
                {
                  "$ref": "#/components/schemas/Uuid"
                }
              ]
            },
            "required": false,
            "name": "assignee",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "A page.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketPage"
                }
              }
            }
          },
          "400": {
            "description": "validation_failed: a parameter or the cursor.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "unauthorized: no valid session.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "forbidden: marketing and viewer; sales reads only the tickets they made; or a refusal of the edge.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "not_found: a workspace not among the session’s.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "service_unavailable: the session or the membership could not be read.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "post": {
        "x-status": "planned",
        "x-sprint": "S4",
        "summary": "Make a ticket (Owner, Admin, Manager, Sales, Support: Phụ lục B \"Ticket: tạo\"), status `new`, from a conversation or not.",
        "tags": [
          "tickets"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^[!-~]{1,255}$",
              "description": "A key the client makes per action (a UUID); sent again with the same request, it gets the first answer back."
            },
            "required": true,
            "description": "A key the client makes per action (a UUID); sent again with the same request, it gets the first answer back.",
            "name": "Idempotency-Key",
            "in": "header"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TicketCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The ticket.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ticket"
                }
              }
            }
          },
          "400": {
            "description": "validation_failed: a field, or the Idempotency-Key is missing.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "unauthorized: no valid session.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "forbidden: marketing and viewer; sales reads only the tickets they made; or a refusal of the edge.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "not_found: the workspace, customer or conversation is not visible.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "idempotency_in_progress: the same key is still running.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "invalid_assignee: not a member of the workspace who handles tickets; or idempotency_key_reused.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "service_unavailable: the session or the membership could not be read.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tickets/{id}": {
      "get": {
        "x-status": "planned",
        "x-sprint": "S4",
        "summary": "One ticket with what happened to it (`events`, oldest first).",
        "tags": [
          "tickets"
        ],
        "parameters": [
          {
            "schema": {
              "$ref": "#/components/schemas/Uuid"
            },
            "required": true,
            "description": "UUIDv7.",
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The ticket.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketDetail"
                }
              }
            }
          },
          "400": {
            "description": "validation_failed: the id.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "unauthorized: no valid session.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "forbidden: marketing and viewer; sales reads only the tickets they made; or a refusal of the edge.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "not_found: no ticket with this id in the session’s workspaces (not visible is the same).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "service_unavailable: the session or the membership could not be read.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "patch": {
        "x-status": "planned",
        "x-sprint": "S4",
        "summary": "Change a ticket (Owner, Admin, Manager, Support). `status` follows new → in_progress → waiting_customer ⇄ in_progress → done (reopen: done → in_progress); `cancelled` from any open state, Owner/Admin/Manager only, and final. Waiting for the customer stops the SLA clock (U27).",
        "tags": [
          "tickets"
        ],
        "parameters": [
          {
            "schema": {
              "$ref": "#/components/schemas/Uuid"
            },
            "required": true,
            "description": "UUIDv7.",
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TicketChange"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The ticket after the change.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ticket"
                }
              }
            }
          },
          "400": {
            "description": "validation_failed: a field, or nothing to change.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "unauthorized: no valid session.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "forbidden: sales, marketing, viewer; `cancelled` asked by support; or a refusal of the edge.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "not_found: no ticket with this id in the session’s workspaces (not visible is the same).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "version_conflict: the ticket changed since it was read; or invalid_transition: this status cannot follow the current one.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "invalid_assignee: not a member of the workspace who handles tickets.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "service_unavailable: the session or the membership could not be read.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
