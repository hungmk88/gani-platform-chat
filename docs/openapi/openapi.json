{
  "openapi": "3.1.0",
  "info": {
    "title": "Gani Platform API",
    "version": "0.1.0",
    "description": "Brief Backend & Core v1.0, P9. Session cookie of Better Auth (/api/auth/*); the organisation and workspaces come from the session, never from a request. Errors are RFC 9457 with a snake_case `code` (N132)."
  },
  "components": {
    "schemas": {
      "SecurityStatus": {
        "type": "object",
        "properties": {
          "twoFactorEnabled": {
            "type": "boolean"
          },
          "required": {
            "type": "boolean"
          },
          "mustSetUp": {
            "type": "boolean"
          }
        },
        "required": [
          "twoFactorEnabled",
          "required",
          "mustSetUp"
        ]
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "about:blank"
            ]
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "detail": {
            "type": "string"
          },
          "traceId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "description": "RFC 9457 problem details; `code` is the stable word (Brief P9)."
      },
      "Me": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Uuid"
          },
          "name": {
            "type": "string"
          },
          "isPlatformOperator": {
            "type": "boolean"
          },
          "org": {
            "$ref": "#/components/schemas/MeOrg"
          },
          "workspaces": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MeWorkspace"
            }
          }
        },
        "required": [
          "id",
          "name",
          "isPlatformOperator",
          "org",
          "workspaces"
        ]
      },
      "Uuid": {
        "type": "string",
        "format": "uuid",
        "description": "UUIDv7."
      },
      "MeOrg": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Uuid"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "admin",
              "manager",
              "sales",
              "support",
              "marketing",
              "viewer"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "role"
        ]
      },
      "MeWorkspace": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Uuid"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "ConversationPage": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Conversation"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "data",
          "nextCursor"
        ]
      },
      "Conversation": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Uuid"
          },
          "workspaceId": {
            "$ref": "#/components/schemas/Uuid"
          },
          "state": {
            "type": "string",
            "enum": [
              "BOT_ACTIVE",
              "HUMAN_WAITING_Q",
              "HUMAN_ACTIVE",
              "PENDING_CUSTOMER",
              "CLOSED"
            ]
          },
          "afterHoursHold": {
            "type": "boolean"
          },
          "assignedUserId": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Uuid"
              },
              {
                "type": [
                  "string",
                  "null"
                ]
              }
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "outcome": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "resolved",
              "no_response",
              "spam",
              "resolved_by_bot",
              null
            ]
          },
          "closedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "lastMessageAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "lastCustomerMessageAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "workspaceId",
          "state",
          "afterHoursHold",
          "assignedUserId",
          "version",
          "outcome",
          "closedAt",
          "lastMessageAt",
          "lastCustomerMessageAt",
          "createdAt"
        ]
      },
      "MessagePage": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Message"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "data",
          "nextCursor"
        ]
      },
      "Message": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Uuid"
          },
          "sequenceNumber": {
            "type": "integer",
            "minimum": 1
          },
          "senderKind": {
            "type": "string",
            "enum": [
              "customer",
              "agent",
              "bot",
              "system"
            ]
          },
          "senderUserId": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Uuid"
              },
              {
                "type": [
                  "string",
                  "null"
                ]
              }
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "text",
              "image",
              "file",
              "sticker",
              "postback",
              "system"
            ]
          },
          "body": {
            "type": [
              "string",
              "null"
            ]
          },
          "platformSentAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "sequenceNumber",
          "senderKind",
          "senderUserId",
          "kind",
          "body",
          "platformSentAt",
          "createdAt"
        ]
      },
      "ClaimConflictProblem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "about:blank"
            ]
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "code": {
            "type": "string",
            "enum": [
              "conversation_already_claimed"
            ]
          },
          "detail": {
            "type": "string"
          },
          "traceId": {
            "type": "string",
            "format": "uuid"
          },
          "assignedUserId": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Uuid"
              },
              {
                "type": [
                  "string",
                  "null"
                ]
              }
            ]
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "assignedUserId"
        ]
      },
      "VersionBody": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "version"
        ],
        "additionalProperties": false
      },
      "AssigneeBody": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "toUserId": {
            "$ref": "#/components/schemas/Uuid"
          }
        },
        "required": [
          "version",
          "toUserId"
        ],
        "additionalProperties": false
      },
      "CloseBody": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "outcome": {
            "type": "string",
            "enum": [
              "resolved",
              "no_response",
              "spam"
            ]
          }
        },
        "required": [
          "version",
          "outcome"
        ],
        "additionalProperties": false
      }
    },
    "parameters": {}
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Liveness: the process is up (touches no dependency).",
        "tags": [
          "platform"
        ],
        "responses": {
          "200": {
            "description": "Alive.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "summary": "Readiness: both databases answer. No reason is given when they do not.",
        "tags": [
          "platform"
        ],
        "responses": {
          "200": {
            "description": "Ready.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "Not ready.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "unavailable"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/me/security-status": {
      "get": {
        "summary": "Whether a second factor is required of the signed-in person, on, and must be set up now (N89).",
        "tags": [
          "me"
        ],
        "responses": {
          "200": {
            "description": "The 2FA status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SecurityStatus"
                }
              }
            }
          },
          "401": {
            "description": "unauthorized: no valid session.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/me": {
      "get": {
        "summary": "The signed-in person, the organisation they act in and its workspaces they belong to (U32, N145). Ask security-status first.",
        "tags": [
          "me"
        ],
        "responses": {
          "200": {
            "description": "`org` is null for a person of no organisation, or of several with none chosen (the other /v1 routes answer 403 then). `name` falls back to the email.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "unauthorized: no valid session.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "two_factor_setup_required: the second factor must be set up first (N93).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "service_unavailable: a database did not answer.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/conversations": {
      "get": {
        "summary": "The Inbox: conversations of the session’s workspaces, most recent activity first. Sales and support see their own and the unclaimed ones (Phụ lục B, N133).",
        "tags": [
          "conversations"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "required": false,
            "name": "cursor",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            },
            "required": false,
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "$ref": "#/components/schemas/Uuid"
            },
            "required": false,
            "description": "UUIDv7.",
            "name": "workspaceId",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "BOT_ACTIVE",
                "HUMAN_WAITING_Q",
                "HUMAN_ACTIVE",
                "PENDING_CUSTOMER",
                "CLOSED"
              ]
            },
            "required": false,
            "name": "state",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            },
            "required": false,
            "name": "hold",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "me",
                "none",
                "any"
              ],
              "default": "any"
            },
            "required": false,
            "name": "assignee",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "A page.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationPage"
                }
              }
            }
          },
          "400": {
            "description": "validation_failed: a parameter or the cursor is not valid.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "unauthorized: no valid session.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "forbidden (marketing, viewer), or a refusal of the edge (no_organisation, org_not_selected, two_factor_setup_required).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "service_unavailable: the session or the membership could not be read.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/conversations/{id}": {
      "get": {
        "summary": "One conversation. Not found and not visible are the same 404 (P9).",
        "tags": [
          "conversations"
        ],
        "parameters": [
          {
            "schema": {
              "$ref": "#/components/schemas/Uuid"
            },
            "required": true,
            "description": "UUIDv7.",
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The conversation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Conversation"
                }
              }
            }
          },
          "400": {
            "description": "validation_failed: a parameter or the cursor is not valid.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "unauthorized: no valid session.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "forbidden (marketing, viewer), or a refusal of the edge (no_organisation, org_not_selected, two_factor_setup_required).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "not_found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "service_unavailable: the session or the membership could not be read.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/conversations/{id}/messages": {
      "get": {
        "summary": "The messages of a conversation, newest first; `nextCursor` pages back.",
        "tags": [
          "conversations"
        ],
        "parameters": [
          {
            "schema": {
              "$ref": "#/components/schemas/Uuid"
            },
            "required": true,
            "description": "UUIDv7.",
            "name": "id",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "required": false,
            "name": "cursor",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            },
            "required": false,
            "name": "limit",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "A page.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessagePage"
                }
              }
            }
          },
          "400": {
            "description": "validation_failed: a parameter or the cursor is not valid.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "unauthorized: no valid session.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "forbidden (marketing, viewer), or a refusal of the edge (no_organisation, org_not_selected, two_factor_setup_required).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "not_found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "service_unavailable: the session or the membership could not be read.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/conversations/{id}/claim": {
      "post": {
        "tags": [
          "conversations"
        ],
        "summary": "Claim a conversation of the queue or held out of hours (T05, T06). Exactly one of many claims at once wins.",
        "parameters": [
          {
            "schema": {
              "$ref": "#/components/schemas/Uuid"
            },
            "required": true,
            "description": "UUIDv7.",
            "name": "id",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "pattern": "^[!-~]{1,255}$",
              "description": "A key the client makes per action (a UUID); sent again with the same request, it gets the first answer back."
            },
            "required": true,
            "description": "A key the client makes per action (a UUID); sent again with the same request, it gets the first answer back.",
            "name": "Idempotency-Key",
            "in": "header"
          }
        ],
        "responses": {
          "200": {
            "description": "The conversation after the action.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Conversation"
                }
              }
            }
          },
          "400": {
            "description": "validation_failed: the id, the body or the Idempotency-Key header.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "unauthorized: no valid session.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "forbidden: the role may not do this, or not on a conversation the person does not hold.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "not_found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "conversation_already_claimed with assignedUserId (who holds it); invalid_transition; idempotency_in_progress.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ClaimConflictProblem"
                }
              }
            }
          },
          "422": {
            "description": "idempotency_key_reused: the key was sent with another request.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "service_unavailable: the session or the membership could not be read.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/conversations/{id}/wait-customer": {
      "post": {
        "tags": [
          "conversations"
        ],
        "summary": "Wait for the customer’s answer (T09). Sales and support: only a conversation they hold.",
        "parameters": [
          {
            "schema": {
              "$ref": "#/components/schemas/Uuid"
            },
            "required": true,
            "description": "UUIDv7.",
            "name": "id",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "pattern": "^[!-~]{1,255}$",
