{
  "permissions": {
    "allow": [
      "Bash(git push -u origin feat/*)",
      "Bash(git push origin feat/*)",
      "Bash(git push -u origin fix/*)",
      "Bash(git push origin fix/*)",
      "Bash(git push -u origin chore/*)",
      "Bash(git push origin chore/*)",
      "Bash(git push -u origin docs/*)",
      "Bash(git push origin docs/*)",
      "Bash(git push -u origin test/*)",
      "Bash(git push origin test/*)",
      "Bash(git push -u origin claude/*)",
      "Bash(git push origin claude/*)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~/*)",
      "Bash(kubectl delete *)",
      "Bash(terraform destroy *)",
      "Bash(terraform apply *production*)",
      "Bash(docker system prune*)",
      "Bash(DROP DATABASE*)",
      "Bash(TRUNCATE*)",
      "Bash(DELETE FROM*)",
      "Bash(git push --force*)",
      "Bash(git reset --hard origin/main*)",
      "Bash(psql *production*)",
      "Bash(pg_dump *production*)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.development)",
      "Read(.env.test)",
      "Read(.env.staging)",
      "Read(.env.production)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Write(.env)",
      "Write(.env.local)",
      "Write(.env.development)",
      "Write(.env.test)",
      "Write(.env.staging)",
      "Write(.env.production)",
      "Bash(git push -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git push -u origin main*)",
      "Bash(git branch -D main*)",
      "Bash(git branch -D master*)",
      "Bash(git checkout main && git merge*)",
      "Bash(git merge --no-ff*)",
      "Bash(git push)",
      "Bash(git push origin +*)",
      "Bash(git push origin *:main*)",
      "Bash(git push origin *:refs/heads/main*)",
      "Bash(git push --delete*)",
      "Bash(git push -d *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)"
    ],
    "ask": [
      "Bash(gh pr create*)",
      "Bash(pnpm deploy*)",
      "Bash(terraform plan*)",
      "Bash(npm publish*)",
      "Bash(pnpm publish*)"
    ]
  },
  "env": {
    "NODE_ENV": "development",
    "SAFE_MODE": "true"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
