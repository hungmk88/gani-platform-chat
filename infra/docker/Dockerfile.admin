# syntax=docker/dockerfile:1
# Image of the admin (gani-admin), Next.js standalone output. Build from the repository root:
#   docker build -f infra/docker/Dockerfile.admin --build-arg API_ORIGIN=<API origin> -t gani-admin:<git sha> .
# linux/amd64 only for now.
ARG NODE_IMAGE=node:22.23.3-slim

FROM ${NODE_IMAGE} AS build
ENV PNPM_HOME=/pnpm CI=true NEXT_TELEMETRY_DISABLED=1
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /repo
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc ./
RUN pnpm fetch
COPY . .
RUN pnpm install --frozen-lockfile --offline
# API_ORIGIN is baked at build time. Changing it requires rebuild. The default fits docker compose (service `api`); production
# normally sends /v1 and /api/auth through its reverse proxy and does not use the rewrites (infra/CLAUDE.md "Docker").
ARG API_ORIGIN=http://api:3000
ENV API_ORIGIN=${API_ORIGIN}
RUN pnpm --filter "@gani/admin..." run build

# server.js, the traced node_modules and the static files only; owned by root, run as `node` (uid 1000).
FROM ${NODE_IMAGE} AS admin
ARG API_ORIGIN=http://api:3000
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=3001 API_ORIGIN=${API_ORIGIN}
WORKDIR /app
COPY --from=build /repo/apps/admin/.next/standalone ./
COPY --from=build /repo/apps/admin/.next/static ./apps/admin/.next/static
USER node
EXPOSE 3001
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:' + (process.env.PORT || 3001) + '/login').then((r) => process.exit(r.ok ? 0 : 1), () => process.exit(1))"]
CMD ["node", "apps/admin/server.js"]
