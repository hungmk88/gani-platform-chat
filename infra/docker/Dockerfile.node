# syntax=docker/dockerfile:1
# Images of the API, the worker and the migration job (infra/CLAUDE.md "Docker"). Build from the repository root, one target each:
#   docker build -f infra/docker/Dockerfile.node --target api -t gani-api:<git sha> .
# Targets: api (gani-api), worker (gani-worker), migrate (gani-migrate). linux/amd64 only for now; @node-rs/argon2 also ships a
# linux-arm64-gnu build, so arm64 would only need buildx, not a build from source.
ARG NODE_IMAGE=node:22.23.3-slim

FROM ${NODE_IMAGE} AS base
ENV PNPM_HOME=/pnpm CI=true
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /repo

# The lockfile alone decides what is downloaded, so this layer stays cached while only the code changes.
FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc ./
RUN pnpm fetch
COPY . .
RUN pnpm install --frozen-lockfile --offline

# `pnpm deploy --prod` writes one folder with the package, its production node_modules and the dist of the workspace packages it
# uses (their "files" is ["dist"]). Only dist, node_modules and package.json of the app are kept: no src, no tests.
FROM deps AS build-api
RUN pnpm --filter "@gani/api..." run build \
  && pnpm --filter @gani/api deploy --prod /deployed \
  && mkdir /out && cp -r /deployed/dist /deployed/node_modules /deployed/package.json /out/

FROM deps AS build-worker
RUN pnpm --filter "@gani/worker..." run build \
  && pnpm --filter @gani/worker deploy --prod /deployed \
  && mkdir /out && cp -r /deployed/dist /deployed/node_modules /deployed/package.json /out/

# Only what migrate.mjs needs: the SQL files, the runner, the lint it runs first, and pg.
FROM deps AS build-migrate
RUN pnpm --filter @gani/db deploy --prod /deployed \
  && mkdir /out && cp -r /deployed/node_modules /deployed/package.json /out/ \
  && cp -r packages/db/migrations packages/db/scripts packages/db/lint /out/

# Runtime images: files owned by root and read-only for the process, which runs as `node` (uid 1000), never as root.
FROM ${NODE_IMAGE} AS api
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3000
WORKDIR /app
COPY --from=build-api /out ./
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:' + (process.env.PORT || 3000) + '/healthz').then((r) => process.exit(r.ok ? 0 : 1), () => process.exit(1))"]
CMD ["node", "dist/main.js"]

FROM ${NODE_IMAGE} AS worker
ENV NODE_ENV=production WORKER_HTTP_PORT=9464
WORKDIR /app
COPY --from=build-worker /out ./
USER node
EXPOSE 9464
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:' + process.env.WORKER_HTTP_PORT + '/healthz').then((r) => process.exit(r.ok ? 0 : 1), () => process.exit(1))"]
CMD ["node", "dist/main.js"]

# A job, not a service: runs the pending migrations as migration_role (DATABASE_URL_MIGRATION) and exits. No port. Runs in the CI/CD
# pipeline before api and worker are deployed, never inside the production runtime.
FROM ${NODE_IMAGE} AS migrate
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build-migrate /out ./
USER node
ENTRYPOINT ["node", "scripts/migrate.mjs"]
